# Python 运行产物
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# 虚拟环境
.venv/
venv/

# 账套数据库与附件 —— 财务数据绝不进代码仓库
backend/data/
/data/

# 密钥与环境配置（只保留 .env.example 模板）
.env
*.env
.env.*
!.env.example
.model_key
.secret_key
.instance_id

# 生成的分享包
.trae-html-share-packages/

# vendored 依赖（体积大，pip 按 requirements.txt 还原即可）
backend/.deps/

# 打包构建产物（.spec 是构建源码保留，venv/exe 产物忽略）
build/
dist/

# IDE 本地工具
.tools/

# 社媒发布素材（视频/截图，非代码资产）
social/

# 根目录杂项：截图、票据 PDF（财务文件不进仓库）
/*.png
/*.pdf

# 系统文件
Thumbs.db
.DS_Store
